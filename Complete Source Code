{
  "name": "dev-portfolio-fullstack",
  "version": "1.0.0",
  "description": "Open-source full-stack developer website with HTML, CSS, SQLite, and JWT security",
  "main": "server.js",
  "scripts": {
    "start": "node server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  }
}



const express = require('express');
const sqlite3 = require('sqlite3').verbose();
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const helmet = require('helmet');
const rateLimit = require('express-rate-limit');
const path = require('path');

const app = express();
const PORT = process.env.PORT || 3000;
const JWT_SECRET = process.env.JWT_SECRET || 'change_this_to_a_strong_random_secret_in_prod';

// 1. SECURITY MIDDLEWARE
app.use(helmet({ contentSecurityPolicy: false })); // Sets secure HTTP headers
app.use(express.json({ limit: '10kb' }));          // Prevents large payload DoS attacks
app.use(express.static(path.join(__dirname, 'public')));

// Rate limiter to prevent brute-force login & spam
const apiLimiter = rateLimit({
  windowMs: 15 * 60 * 1000, // 15 minutes
  max: 100,
  message: { error: 'Too many requests, please try again later.' }
});
app.use('/api/', apiLimiter);

// 2. DATABASE SETUP (SQLite)
const db = new sqlite3.Database('./database/portfolio.db', (err) => {
  if (err) console.error('Database connection error:', err.message);
  else console.log('Connected to SQLite database.');
});

db.serialize(() => {
  // Users table (Admin)
  db.run(`CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT UNIQUE NOT NULL,
    password_hash TEXT NOT NULL
  )`);

  // Projects table
  db.run(`CREATE TABLE IF NOT EXISTS projects (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT NOT NULL,
    tech_stack TEXT NOT NULL,
    repo_url TEXT
  )`);

  // Contact Messages table
  db.run(`CREATE TABLE IF NOT EXISTS messages (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sender_name TEXT NOT NULL,
    sender_email TEXT NOT NULL,
    message TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
  )`);

  // Seed default Admin user (admin / Admin@123) & sample project if empty
  db.get("SELECT COUNT(*) AS count FROM users", async (err, row) => {
    if (row.count === 0) {
      const hash = await bcrypt.hash('Admin@123', 10);
      db.run("INSERT INTO users (username, password_hash) VALUES (?, ?)", ['admin', hash]);
    }
  });

  db.get("SELECT COUNT(*) AS count FROM projects", (err, row) => {
    if (row.count === 0) {
      db.run(
        "INSERT INTO projects (title, description, tech_stack, repo_url) VALUES (?, ?, ?, ?)",
        [
          'Open-Source Task API',
          'RESTful microservice with JWT auth, rate-limiting, and automated CI/CD.',
          'Node.js, Express, SQLite',
          'https://github.com/'
        ]
      );
    }
  });
});

// 3. AUTHENTICATION MIDDLEWARE (Protects Admin Routes)
function authenticateToken(req, res, next) {
  const authHeader = req.headers['authorization'];
  const token = authHeader && authHeader.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Access denied. Token missing.' });

  jwt.verify(token, JWT_SECRET, (err, user) => {
    if (err) return res.status(403).json({ error: 'Invalid or expired token.' });
    req.user = user;
    next();
  });
}

// 4. API ROUTES

// Public: Fetch all projects
app.get('/api/projects', (req, res) => {
  db.all("SELECT * FROM projects ORDER BY id DESC", [], (err, rows) => {
    if (err) return res.status(500).json({ error: 'Database error' });
    res.json(rows);
  });
});

// Public: Submit contact form (Parameterized query prevents SQL Injection)
app.post('/api/contact', (req, res) => {
  const { name, email, message } = req.body;
  if (!name || !email || !message) {
    return res.status(400).json({ error: 'All fields are required.' });
  }
  const stmt = db.prepare("INSERT INTO messages (sender_name, sender_email, message) VALUES (?, ?, ?)");
  stmt.run([name.trim(), email.trim(), message.trim()], function (err) {
    if (err) return res.status(500).json({ error: 'Failed to save message.' });
    res.status(201).json({ success: true, message: 'Message received!' });
  });
  stmt.finalize();
});

// Public: Admin Login
app.post('/api/login', (req, res) => {
  const { username, password } = req.body;
  db.get("SELECT * FROM users WHERE username = ?", [username], async (err, user) => {
    if (err || !user) return res.status(401).json({ error: 'Invalid credentials.' });

    const validPassword = await bcrypt.compare(password, user.password_hash);
    if (!validPassword) return res.status(401).json({ error: 'Invalid credentials.' });

    const token = jwt.sign({ id: user.id, username: user.username }, JWT_SECRET, { expiresIn: '2h' });
    res.json({ token });
  });
});

// Protected: Add a new project (Admin only)
app.post('/api/projects', authenticateToken, (req, res) => {
  const { title, description, tech_stack, repo_url } = req.body;
  if (!title || !description || !tech_stack) {
    return res.status(400).json({ error: 'Title, description, and tech stack are required.' });
  }
  db.run(
    "INSERT INTO projects (title, description, tech_stack, repo_url) VALUES (?, ?, ?, ?)",
    [title, description, tech_stack, repo_url || '#'],
    function (err) {
      if (err) return res.status(500).json({ error: 'Failed to add project.' });
      res.status(201).json({ id: this.lastID, title, description, tech_stack, repo_url });
    }
  );
});

// Protected: View contact messages (Admin only)
app.get('/api/messages', authenticateToken, (req, res) => {
  db.all("SELECT * FROM messages ORDER BY created_at DESC", [], (err, rows) => {
    if (err) return res.status(500).json({ error: 'Database error' });
    res.json(rows);
  });
});

app.listen(PORT, () => console.log(`Server running at http://localhost:${PORT}`));
