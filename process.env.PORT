{
  "name": "dev-portfolio-fullstack",
  "version": "1.0.0",
  "description": "Open-source full-stack developer website with HTML, CSS, SQLite, and JWT security",
  "main": "server.js",
  "scripts": {
    "start": "node server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  }
}

dev-portfolio-fullstack/
├── database/
│   └── portfolio.db         # Auto-generated SQLite database
├── public/
│   ├── index.html           # Main Developer Portfolio & Login/Contact UI
│   ├── style.css            # Modern Responsive CSS
│   └── app.js               # Frontend Fetch API & DOM logic
├── server.js                # Backend API, Security Middleware & DB Logic
└── package.json             # Dependencies
